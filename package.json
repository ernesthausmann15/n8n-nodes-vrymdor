{
  "name": "n8n-nodes-vrymdor",
  "version": "1.1.2",
  "description": "Vrymdor AI Node for n8n: mask personal data and secrets, and run tools, model calls and webhooks through your Vrymdor AI Node, with policy and audit on every step.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "vrymdor",
    "ai governance",
    "pii",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://vrymdor.com/developers/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernesthausmann15/n8n-nodes-vrymdor.git"
  },
  "bugs": {
    "url": "https://github.com/ernesthausmann15/n8n-nodes-vrymdor/issues"
  },
  "author": {
    "name": "Vrymnox Systems LLC (maker of Vrymdor AI Node)",
    "email": "ernesth@vrymnox.com",
    "url": "https://vrymdor.com"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && cp nodes/Vrymdor/vrymdor.svg nodes/Vrymdor/vrymdor.dark.svg dist/nodes/Vrymdor/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VrymdorApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Vrymdor/Vrymdor.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "typescript": "~5.6.0"
  }
}
